# Tectonica core ontology v0.1
# SPDX-License-Identifier: CC-BY-4.0
# Copyright the Tectonica contributors. Licensed under the Creative Commons
# Attribution 4.0 International License (see ontology/LICENSE).
#
# Aligned to BOT (https://w3id.org/bot#). IFC class names are given with the
# annotation tec:ifcClass (IFC 4.3 ADD2 names; IFC4 names noted in comments
# where they differ).

@prefix tec:     <https://w3id.org/tectonica/core#> .
@prefix bot:     <https://w3id.org/bot#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann:    <http://purl.org/vocab/vann/> .

<https://w3id.org/tectonica/core>
    a owl:Ontology ;
    owl:versionIRI <https://w3id.org/tectonica/core/0.1> ;
    owl:versionInfo "0.1.0" ;
    dcterms:title "Tectonica core ontology"@en ;
    dcterms:description "An ontology of parts for architecture and the built world. Physical elements form the base layer; rooms and other human definitions are abstractions laid over it; components, containers, material states and provenance are separate logical layers that refer to the same element identifiers."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:creator "Tectonica contributors" ;
    vann:preferredNamespacePrefix "tec" ;
    vann:preferredNamespaceUri "https://w3id.org/tectonica/core#" ;
    rdfs:seeAlso <https://w3id.org/bot> .

#################################################################
# Annotation properties (mapping to IFC)
#################################################################

tec:ifcClass a owl:AnnotationProperty ;
    rdfs:label "IFC class"@en ;
    rdfs:comment "Name of the IFC entity that represents instances of this class in the IFC side of the canonical pair."@en .

tec:ifcPredefinedType a owl:AnnotationProperty ;
    rdfs:label "IFC predefined type"@en ;
    rdfs:comment "PredefinedType value that, together with tec:ifcClass, identifies this class in IFC."@en .

tec:ifcObjectType a owl:AnnotationProperty ;
    rdfs:label "IFC object type"@en ;
    rdfs:comment "ObjectType value used with a USERDEFINED predefined type to identify this class in IFC."@en .

#################################################################
# External terms used (declared, not imported)
#################################################################

bot:Zone a owl:Class ; rdfs:isDefinedBy <https://w3id.org/bot#> .
bot:Site a owl:Class ; rdfs:isDefinedBy <https://w3id.org/bot#> .
bot:Building a owl:Class ; rdfs:isDefinedBy <https://w3id.org/bot#> .
bot:Storey a owl:Class ; rdfs:isDefinedBy <https://w3id.org/bot#> .
bot:Space a owl:Class ; rdfs:isDefinedBy <https://w3id.org/bot#> .
bot:Element a owl:Class ; rdfs:isDefinedBy <https://w3id.org/bot#> .
bot:adjacentZone a owl:ObjectProperty ; rdfs:isDefinedBy <https://w3id.org/bot#> .
bot:hostsElement a owl:ObjectProperty ; rdfs:isDefinedBy <https://w3id.org/bot#> .
bot:hasSubElement a owl:ObjectProperty ; rdfs:isDefinedBy <https://w3id.org/bot#> .
prov:Plan a owl:Class ; rdfs:isDefinedBy <http://www.w3.org/ns/prov#> .
prov:SoftwareAgent a owl:Class ; rdfs:isDefinedBy <http://www.w3.org/ns/prov#> .
prov:Activity a owl:Class ; rdfs:isDefinedBy <http://www.w3.org/ns/prov#> .
prov:Entity a owl:Class ; rdfs:isDefinedBy <http://www.w3.org/ns/prov#> .

#################################################################
# Classes: spatial structure
#################################################################

tec:SpatialElement a owl:Class ;
    rdfs:subClassOf bot:Zone ;
    tec:ifcClass "IfcSpatialElement" ;
    rdfs:label "Spatial element"@en ;
    rdfs:comment "A part of the world defined by its extent rather than by matter: site, building, storey or space."@en .

tec:Site a owl:Class ;
    rdfs:subClassOf tec:SpatialElement , bot:Site ;
    tec:ifcClass "IfcSite" ;
    rdfs:label "Site"@en ;
    rdfs:comment "A piece of land with its built and unbuilt parts; the root of the spatial structure of a project."@en .

tec:Building a owl:Class ;
    rdfs:subClassOf tec:Facility , bot:Building ;
    tec:ifcClass "IfcBuilding" ;
    rdfs:label "Building"@en ;
    rdfs:comment "A structure that provides shelter, located on a site and decomposed into storeys."@en .

tec:Storey a owl:Class ;
    rdfs:subClassOf tec:SpatialElement , bot:Storey ;
    tec:ifcClass "IfcBuildingStorey" ;
    rdfs:label "Storey"@en ;
    rdfs:comment "A horizontal level of a building with an elevation, decomposed into spaces."@en .

tec:Space a owl:Class ;
    rdfs:subClassOf tec:SpatialElement , bot:Space ;
    tec:ifcClass "IfcSpace" ;
    rdfs:label "Space"@en ;
    rdfs:comment "A physical void volume bounded by elements. It carries no human meaning by itself: names and functions belong to a tec:Room laid over it."@en .

tec:ExteriorSpace a owl:Class ;
    rdfs:subClassOf tec:Space ;
    tec:ifcClass "IfcSpace" ;
    tec:ifcPredefinedType "EXTERNAL" ;
    rdfs:label "Exterior space"@en ;
    rdfs:comment "The open space of a site outside buildings. It is the 'outside' node of topology graphs."@en .

tec:Facility a owl:Class ;
    rdfs:subClassOf tec:SpatialElement ;
    tec:ifcClass "IfcFacility" ;
    rdfs:label "Facility"@en ;
    rdfs:comment "A built work as a whole, such as a building, bridge, road, railway or port, decomposed into parts or storeys. IFC 4.3 entity; IFC4 knows only IfcBuilding."@en .

tec:Bridge a owl:Class ;
    rdfs:subClassOf tec:Facility ;
    tec:ifcClass "IfcBridge" ;
    rdfs:label "Bridge"@en ;
    rdfs:comment "A facility that carries a road, railway or path over an obstacle such as a river or a valley."@en .

tec:Road a owl:Class ;
    rdfs:subClassOf tec:Facility ;
    tec:ifcClass "IfcRoad" ;
    rdfs:label "Road"@en ;
    rdfs:comment "A facility for road traffic as a spatial whole, decomposed into road parts. The paved surface itself is a tec:RoadSurface element."@en .

tec:Railway a owl:Class ;
    rdfs:subClassOf tec:Facility ;
    tec:ifcClass "IfcRailway" ;
    rdfs:label "Railway"@en ;
    rdfs:comment "A facility for rail traffic as a spatial whole, decomposed into railway parts."@en .

tec:MarineFacility a owl:Class ;
    rdfs:subClassOf tec:Facility ;
    tec:ifcClass "IfcMarineFacility" ;
    rdfs:label "Marine facility"@en ;
    rdfs:comment "A port, quay, breakwater, canal or other facility at the water."@en .

tec:FacilityPart a owl:Class ;
    rdfs:subClassOf tec:SpatialElement ;
    tec:ifcClass "IfcFacilityPart" ;
    rdfs:label "Facility part"@en ;
    rdfs:comment "A spatial part of a facility, such as a road segment, a bridge span or a section of railway track."@en .

tec:SpatialZone a owl:Class ;
    rdfs:subClassOf tec:SpatialElement ;
    tec:ifcClass "IfcSpatialZone" ;
    rdfs:label "Spatial zone"@en ;
    rdfs:comment "A volume defined for a purpose that cuts across the spatial structure, such as a fire compartment, a thermal zone or the gross volume of a house. It is not matter and does not bound spaces."@en .

tec:ExternalArea a owl:Class ;
    rdfs:subClassOf tec:SpatialElement ;
    tec:ifcClass "IfcExternalSpatialElement" ;
    rdfs:label "External area"@en ;
    rdfs:comment "An outside part of a site defined by its extent, such as a garden, a yard or a parking area."@en .

#################################################################
# Classes: physical objects and elements
#################################################################

tec:PhysicalObject a owl:Class ;
    rdfs:label "Physical object"@en ;
    rdfs:comment "Anything made of matter: fixed elements of the built world and portable objects."@en .

tec:PhysicalElement a owl:Class ;
    rdfs:subClassOf tec:PhysicalObject , bot:Element ;
    tec:ifcClass "IfcElement" ;
    rdfs:label "Physical element"@en ;
    rdfs:comment "A fixed physical part of the built world with exact parametric geometry, stored on the IFC side."@en .

tec:BuiltElement a owl:Class ;
    rdfs:subClassOf tec:PhysicalElement ;
    tec:ifcClass "IfcBuiltElement" ;
    rdfs:label "Built element"@en ;
    rdfs:comment "A physical element that is part of the construction (IfcBuildingElement in IFC4)."@en .

tec:Wall a owl:Class ;
    rdfs:subClassOf tec:BuiltElement ;
    tec:ifcClass "IfcWall" ;
    rdfs:label "Wall"@en ;
    rdfs:comment "A vertical element that bounds or subdivides spaces. Openings are placed on its plane by coordinates along and up the wall."@en .

tec:Slab a owl:Class ;
    rdfs:subClassOf tec:BuiltElement ;
    tec:ifcClass "IfcSlab" ;
    rdfs:label "Slab"@en ;
    rdfs:comment "A planar, mostly horizontal element: floor, ceiling deck or base slab."@en .

tec:RoofSlab a owl:Class ;
    rdfs:subClassOf tec:Slab ;
    tec:ifcClass "IfcSlab" ;
    tec:ifcPredefinedType "ROOF" ;
    rdfs:label "Roof slab"@en ;
    rdfs:comment "A slab that forms a plane of a roof; part of a tec:Roof."@en .

tec:Roof a owl:Class ;
    rdfs:subClassOf tec:BuiltElement ;
    tec:ifcClass "IfcRoof" ;
    rdfs:label "Roof"@en ;
    rdfs:comment "The covering of the top of a building, usually an aggregate of roof slabs."@en .

tec:Opening a owl:Class ;
    rdfs:subClassOf tec:Feature ;
    tec:ifcClass "IfcOpeningElement" ;
    rdfs:label "Opening"@en ;
    rdfs:comment "A void cut through a host element, placed parametrically on the host. It is not matter; a door or window may fill it, or it may stay open as a passage."@en .

tec:Door a owl:Class ;
    rdfs:subClassOf tec:BuiltElement ;
    tec:ifcClass "IfcDoor" ;
    rdfs:label "Door"@en ;
    rdfs:comment "A built element that fills an opening and can be passed through when open."@en .

tec:Window a owl:Class ;
    rdfs:subClassOf tec:BuiltElement ;
    tec:ifcClass "IfcWindow" ;
    rdfs:label "Window"@en ;
    rdfs:comment "A built element that fills an opening and admits light and view but is not a passage."@en .

tec:Stair a owl:Class ;
    rdfs:subClassOf tec:BuiltElement ;
    tec:ifcClass "IfcStair" ;
    rdfs:label "Stair"@en ;
    rdfs:comment "A vertical passage made of flights and landings that connects spaces on different levels."@en .

tec:StairFlight a owl:Class ;
    rdfs:subClassOf tec:BuiltElement ;
    tec:ifcClass "IfcStairFlight" ;
    rdfs:label "Stair flight"@en ;
    rdfs:comment "An uninterrupted run of steps, part of a stair."@en .

tec:Railing a owl:Class ;
    rdfs:subClassOf tec:BuiltElement ;
    tec:ifcClass "IfcRailing" ;
    rdfs:label "Railing"@en ;
    rdfs:comment "A guard or handrail along an edge, such as a stairwell or a stair flight."@en .

tec:RoadSurface a owl:Class ;
    rdfs:subClassOf tec:BuiltElement ;
    tec:ifcClass "IfcPavement" ;
    rdfs:label "Road surface"@en ;
    rdfs:comment "The physical paved surface of a road or path: length, width, elevation, material, curvature. Lanes and traffic are a separate movement layer. IFC 4.3 entity; no direct IFC4 equivalent (IfcSlab is used there)."@en .

tec:Curb a owl:Class ;
    rdfs:subClassOf tec:BuiltElement ;
    tec:ifcClass "IfcKerb" ;
    rdfs:label "Curb"@en ;
    rdfs:comment "A raised edge between a road surface and a sidewalk or verge. IFC 4.3 entity (IfcKerb); no IFC4 equivalent."@en .

tec:Terrain a owl:Class ;
    rdfs:subClassOf tec:GeographicElement ;
    tec:ifcClass "IfcGeographicElement" ;
    tec:ifcPredefinedType "TERRAIN" ;
    rdfs:label "Terrain"@en ;
    rdfs:comment "The ground of a site as a physical element."@en .

tec:Furnishing a owl:Class ;
    rdfs:subClassOf tec:PhysicalElement ;
    tec:ifcClass "IfcFurnishingElement" ;
    rdfs:label "Furnishing"@en ;
    rdfs:comment "A movable but placed physical element such as furniture or a mat (IfcFurnishingElement family)."@en .

tec:Mat a owl:Class ;
    rdfs:subClassOf tec:Furnishing ;
    tec:ifcClass "IfcFurniture" ;
    tec:ifcPredefinedType "USERDEFINED" ;
    tec:ifcObjectType "MAT" ;
    rdfs:label "Mat"@en ;
    rdfs:comment "A flat textile or fibre object lying on a floor or the ground, such as a doormat. Objects can be placed under it."@en .

tec:Beam a owl:Class ;
    rdfs:subClassOf tec:BuiltElement ;
    tec:ifcClass "IfcBeam" ;
    rdfs:label "Beam"@en ;
    rdfs:comment "A mostly horizontal linear element that carries loads across a span to columns or walls."@en .

tec:Column a owl:Class ;
    rdfs:subClassOf tec:BuiltElement ;
    tec:ifcClass "IfcColumn" ;
    rdfs:label "Column"@en ;
    rdfs:comment "A mostly vertical linear element that carries loads down towards the foundation."@en .

tec:Member a owl:Class ;
    rdfs:subClassOf tec:BuiltElement ;
    tec:ifcClass "IfcMember" ;
    rdfs:label "Member"@en ;
    rdfs:comment "A linear element that is neither a beam nor a column: a brace, strut, rafter, purlin or mullion."@en .

tec:Plate a owl:Class ;
    rdfs:subClassOf tec:BuiltElement ;
    tec:ifcClass "IfcPlate" ;
    rdfs:label "Plate"@en ;
    rdfs:comment "A thin planar element, such as a glass pane in a curtain wall or a steel sheet."@en .

tec:Footing a owl:Class ;
    rdfs:subClassOf tec:BuiltElement ;
    tec:ifcClass "IfcFooting" ;
    rdfs:label "Footing"@en ;
    rdfs:comment "A shallow foundation that spreads the load of a wall or column into the ground."@en .

tec:DeepFoundation a owl:Class ;
    rdfs:subClassOf tec:BuiltElement ;
    tec:ifcClass "IfcDeepFoundation" ;
    rdfs:label "Deep foundation"@en ;
    rdfs:comment "A foundation that carries loads deep into the ground, such as a pile or a caisson."@en .

tec:Pile a owl:Class ;
    rdfs:subClassOf tec:DeepFoundation ;
    tec:ifcClass "IfcPile" ;
    rdfs:label "Pile"@en ;
    rdfs:comment "A slender deep foundation driven or cast into the ground."@en .

tec:Bearing a owl:Class ;
    rdfs:subClassOf tec:BuiltElement ;
    tec:ifcClass "IfcBearing" ;
    rdfs:label "Bearing"@en ;
    rdfs:comment "A device that passes loads between parts of a structure while letting them move, as between a bridge deck and its piers."@en .

tec:CurtainWall a owl:Class ;
    rdfs:subClassOf tec:BuiltElement ;
    tec:ifcClass "IfcCurtainWall" ;
    rdfs:label "Curtain wall"@en ;
    rdfs:comment "An outer wall that carries no floor loads and hangs on the structure, usually a frame of members filled with glass or panels."@en .

tec:Covering a owl:Class ;
    rdfs:subClassOf tec:BuiltElement ;
    tec:ifcClass "IfcCovering" ;
    rdfs:label "Covering"@en ;
    rdfs:comment "A finish or layer applied to another element: flooring, ceiling, cladding, roofing, insulation or skirting."@en .

tec:Ceiling a owl:Class ;
    rdfs:subClassOf tec:Covering ;
    tec:ifcClass "IfcCovering" ;
    tec:ifcPredefinedType "CEILING" ;
    rdfs:label "Ceiling"@en ;
    rdfs:comment "A covering on the underside of a slab or roof that closes a space at the top."@en .

tec:Flooring a owl:Class ;
    rdfs:subClassOf tec:Covering ;
    tec:ifcClass "IfcCovering" ;
    tec:ifcPredefinedType "FLOORING" ;
    rdfs:label "Flooring"@en ;
    rdfs:comment "The walking surface laid on a floor slab, such as tiles, boards or carpet."@en .

tec:Cladding a owl:Class ;
    rdfs:subClassOf tec:Covering ;
    tec:ifcClass "IfcCovering" ;
    tec:ifcPredefinedType "CLADDING" ;
    rdfs:label "Cladding"@en ;
    rdfs:comment "An outer layer on a wall that protects it from the weather and gives the facade its look."@en .

tec:RoofCovering a owl:Class ;
    rdfs:subClassOf tec:Covering ;
    tec:ifcClass "IfcCovering" ;
    tec:ifcPredefinedType "ROOFING" ;
    rdfs:label "Roof covering"@en ;
    rdfs:comment "The weatherproof outer layer of a roof, such as tiles, sheets or a membrane."@en .

tec:ShadingDevice a owl:Class ;
    rdfs:subClassOf tec:BuiltElement ;
    tec:ifcClass "IfcShadingDevice" ;
    rdfs:label "Shading device"@en ;
    rdfs:comment "A fixed or movable element that shades windows or facades: louvres, awnings, shutters."@en .

tec:Chimney a owl:Class ;
    rdfs:subClassOf tec:BuiltElement ;
    tec:ifcClass "IfcChimney" ;
    rdfs:label "Chimney"@en ;
    rdfs:comment "A vertical element that carries smoke or exhaust gases out of a building."@en .

tec:Ramp a owl:Class ;
    rdfs:subClassOf tec:BuiltElement ;
    tec:ifcClass "IfcRamp" ;
    rdfs:label "Ramp"@en ;
    rdfs:comment "An inclined surface that connects levels for walking, wheelchairs or vehicles, made of ramp flights and landings."@en .

tec:RampFlight a owl:Class ;
    rdfs:subClassOf tec:BuiltElement ;
    tec:ifcClass "IfcRampFlight" ;
    rdfs:label "Ramp flight"@en ;
    rdfs:comment "An uninterrupted inclined run, part of a ramp."@en .

tec:TransportElement a owl:Class ;
    rdfs:subClassOf tec:PhysicalElement ;
    tec:ifcClass "IfcTransportElement" ;
    rdfs:label "Transport element"@en ;
    rdfs:comment "Equipment that moves people or goods within a facility: an elevator, escalator, moving walkway or crane."@en .

tec:Elevator a owl:Class ;
    rdfs:subClassOf tec:TransportElement ;
    tec:ifcClass "IfcTransportElement" ;
    tec:ifcPredefinedType "ELEVATOR" ;
    rdfs:label "Elevator"@en ;
    rdfs:comment "A car that carries people or goods vertically between levels."@en .

tec:Escalator a owl:Class ;
    rdfs:subClassOf tec:TransportElement ;
    tec:ifcClass "IfcTransportElement" ;
    tec:ifcPredefinedType "ESCALATOR" ;
    rdfs:label "Escalator"@en ;
    rdfs:comment "A moving stair that carries people between levels."@en .

tec:Vehicle a owl:Class ;
    rdfs:subClassOf tec:PhysicalElement ;
    tec:ifcClass "IfcVehicle" ;
    rdfs:label "Vehicle"@en ;
    rdfs:comment "A vehicle modelled as part of a facility, such as a cable car cabin or a ferry."@en .

tec:CivilElement a owl:Class ;
    rdfs:subClassOf tec:PhysicalElement ;
    tec:ifcClass "IfcCivilElement" ;
    rdfs:label "Civil element"@en ;
    rdfs:comment "A civil engineering element for which IFC has no more specific class."@en .

tec:Course a owl:Class ;
    rdfs:subClassOf tec:BuiltElement ;
    tec:ifcClass "IfcCourse" ;
    rdfs:label "Course"@en ;
    rdfs:comment "A layer of a built-up construction, such as a pavement layer, a railway ballast bed or a breakwater armour layer."@en .

tec:Rail a owl:Class ;
    rdfs:subClassOf tec:BuiltElement ;
    tec:ifcClass "IfcRail" ;
    rdfs:label "Rail"@en ;
    rdfs:comment "A rail of a railway or tram track."@en .

tec:TrackElement a owl:Class ;
    rdfs:subClassOf tec:BuiltElement ;
    tec:ifcClass "IfcTrackElement" ;
    rdfs:label "Track element"@en ;
    rdfs:comment "A part of a railway track other than the rail itself: a sleeper, a buffer stop, a fastening."@en .

tec:MooringDevice a owl:Class ;
    rdfs:subClassOf tec:BuiltElement ;
    tec:ifcClass "IfcMooringDevice" ;
    rdfs:label "Mooring device"@en ;
    rdfs:comment "A bollard, fender or other device used to moor vessels."@en .

tec:NavigationElement a owl:Class ;
    rdfs:subClassOf tec:BuiltElement ;
    tec:ifcClass "IfcNavigationElement" ;
    rdfs:label "Navigation element"@en ;
    rdfs:comment "A beacon, buoy or other aid to navigation on water."@en .

tec:EarthworksElement a owl:Class ;
    rdfs:subClassOf tec:BuiltElement ;
    tec:ifcClass "IfcEarthworksElement" ;
    rdfs:label "Earthworks element"@en ;
    rdfs:comment "A body of soil or rock placed as part of a construction."@en .

tec:EarthworksFill a owl:Class ;
    rdfs:subClassOf tec:EarthworksElement ;
    tec:ifcClass "IfcEarthworksFill" ;
    rdfs:label "Earthworks fill"@en ;
    rdfs:comment "Soil, sand or other bulk material placed to raise or level the ground, such as an embankment or the bedding under a floor slab."@en .

tec:ReinforcedSoil a owl:Class ;
    rdfs:subClassOf tec:EarthworksElement ;
    tec:ifcClass "IfcReinforcedSoil" ;
    rdfs:label "Reinforced soil"@en ;
    rdfs:comment "Soil strengthened with layers of reinforcement, as in a retaining embankment."@en .

tec:GeographicElement a owl:Class ;
    rdfs:subClassOf tec:PhysicalElement ;
    tec:ifcClass "IfcGeographicElement" ;
    rdfs:label "Geographic element"@en ;
    rdfs:comment "A natural or landscape element of a site, such as terrain or vegetation."@en .

tec:Vegetation a owl:Class ;
    rdfs:subClassOf tec:GeographicElement ;
    tec:ifcClass "IfcGeographicElement" ;
    tec:ifcPredefinedType "VEGETATION" ;
    rdfs:label "Vegetation"@en ;
    rdfs:comment "Trees, hedges, lawns and other plants as physical elements of a site."@en .

tec:GeotechnicalElement a owl:Class ;
    rdfs:subClassOf tec:PhysicalElement ;
    tec:ifcClass "IfcGeotechnicalElement" ;
    rdfs:label "Geotechnical element"@en ;
    rdfs:comment "The ground below the surface as known from investigation: soil and rock layers, boreholes, ground models."@en .

tec:Stratum a owl:Class ;
    rdfs:subClassOf tec:GeotechnicalElement ;
    tec:ifcClass "IfcGeotechnicalStratum" ;
    rdfs:label "Stratum"@en ;
    rdfs:comment "A layer of soil or rock in the ground."@en .

tec:DistributionElement a owl:Class ;
    rdfs:subClassOf tec:PhysicalElement ;
    tec:ifcClass "IfcDistributionElement" ;
    rdfs:label "Distribution element"@en ;
    rdfs:comment "A part of the services of a building or a city: water, drainage, gas, heating, ventilation, power, lighting or data."@en .

tec:FlowSegment a owl:Class ;
    rdfs:subClassOf tec:DistributionElement ;
    tec:ifcClass "IfcFlowSegment" ;
    rdfs:label "Flow segment"@en ;
    rdfs:comment "A run of pipe, duct, cable or cable tray that carries a flow."@en .

tec:Pipe a owl:Class ;
    rdfs:subClassOf tec:FlowSegment ;
    tec:ifcClass "IfcPipeSegment" ;
    rdfs:label "Pipe"@en ;
    rdfs:comment "A pipe that carries water, gas, sewage or another fluid."@en .

tec:Duct a owl:Class ;
    rdfs:subClassOf tec:FlowSegment ;
    tec:ifcClass "IfcDuctSegment" ;
    rdfs:label "Duct"@en ;
    rdfs:comment "A duct that carries air."@en .

tec:Cable a owl:Class ;
    rdfs:subClassOf tec:FlowSegment ;
    tec:ifcClass "IfcCableSegment" ;
    rdfs:label "Cable"@en ;
    rdfs:comment "A cable that carries power or data."@en .

tec:FlowFitting a owl:Class ;
    rdfs:subClassOf tec:DistributionElement ;
    tec:ifcClass "IfcFlowFitting" ;
    rdfs:label "Flow fitting"@en ;
    rdfs:comment "A bend, tee, junction box or other connector between flow segments."@en .

tec:FlowTerminal a owl:Class ;
    rdfs:subClassOf tec:DistributionElement ;
    tec:ifcClass "IfcFlowTerminal" ;
    rdfs:label "Flow terminal"@en ;
    rdfs:comment "A device where a flow ends or is used: a tap, toilet, light, socket or air outlet."@en .

tec:SanitaryTerminal a owl:Class ;
    rdfs:subClassOf tec:FlowTerminal ;
    tec:ifcClass "IfcSanitaryTerminal" ;
    rdfs:label "Sanitary terminal"@en ;
    rdfs:comment "A toilet, washbasin, sink, bath or shower."@en .

tec:LightFixture a owl:Class ;
    rdfs:subClassOf tec:FlowTerminal ;
    tec:ifcClass "IfcLightFixture" ;
    rdfs:label "Light fixture"@en ;
    rdfs:comment "A light fitting, indoors or in a street."@en .

tec:Outlet a owl:Class ;
    rdfs:subClassOf tec:FlowTerminal ;
    tec:ifcClass "IfcOutlet" ;
    rdfs:label "Outlet"@en ;
    rdfs:comment "A socket for power or data."@en .

tec:ElectricAppliance a owl:Class ;
    rdfs:subClassOf tec:FlowTerminal ;
    tec:ifcClass "IfcElectricAppliance" ;
    rdfs:label "Electric appliance"@en ;
    rdfs:comment "An appliance connected to power, such as a refrigerator, cooker or washing machine."@en .

tec:SpaceHeater a owl:Class ;
    rdfs:subClassOf tec:FlowTerminal ;
    tec:ifcClass "IfcSpaceHeater" ;
    rdfs:label "Space heater"@en ;
    rdfs:comment "A radiator, convector or other heater that warms a space."@en .

tec:AirTerminal a owl:Class ;
    rdfs:subClassOf tec:FlowTerminal ;
    tec:ifcClass "IfcAirTerminal" ;
    rdfs:label "Air terminal"@en ;
    rdfs:comment "A grille or diffuser where air enters or leaves a space."@en .

tec:FireSuppressionTerminal a owl:Class ;
    rdfs:subClassOf tec:FlowTerminal ;
    tec:ifcClass "IfcFireSuppressionTerminal" ;
    rdfs:label "Fire suppression terminal"@en ;
    rdfs:comment "A sprinkler, hydrant or hose reel."@en .

tec:Signal a owl:Class ;
    rdfs:subClassOf tec:FlowTerminal ;
    tec:ifcClass "IfcSignal" ;
    rdfs:label "Signal"@en ;
    rdfs:comment "A traffic light, railway signal or other signalling light."@en .

tec:FlowController a owl:Class ;
    rdfs:subClassOf tec:DistributionElement ;
    tec:ifcClass "IfcFlowController" ;
    rdfs:label "Flow controller"@en ;
    rdfs:comment "A device that regulates or switches a flow: a valve, damper, switch, meter or distribution board."@en .

tec:Valve a owl:Class ;
    rdfs:subClassOf tec:FlowController ;
    tec:ifcClass "IfcValve" ;
    rdfs:label "Valve"@en ;
    rdfs:comment "A valve that opens, closes or regulates a pipe."@en .

tec:Switch a owl:Class ;
    rdfs:subClassOf tec:FlowController ;
    tec:ifcClass "IfcSwitchingDevice" ;
    rdfs:label "Switch"@en ;
    rdfs:comment "A light switch or other device that switches power."@en .

tec:DistributionBoard a owl:Class ;
    rdfs:subClassOf tec:FlowController ;
    tec:ifcClass "IfcDistributionBoard" ;
    rdfs:label "Distribution board"@en ;
    rdfs:comment "A panel that splits a power or data supply into circuits, with its breakers or switches."@en .

tec:FlowMovingDevice a owl:Class ;
    rdfs:subClassOf tec:DistributionElement ;
    tec:ifcClass "IfcFlowMovingDevice" ;
    rdfs:label "Flow moving device"@en ;
    rdfs:comment "A pump, fan or compressor that moves a flow."@en .

tec:FlowStorageDevice a owl:Class ;
    rdfs:subClassOf tec:DistributionElement ;
    tec:ifcClass "IfcFlowStorageDevice" ;
    rdfs:label "Flow storage device"@en ;
    rdfs:comment "A tank, cistern or battery that stores what flows."@en .

tec:Tank a owl:Class ;
    rdfs:subClassOf tec:FlowStorageDevice ;
    tec:ifcClass "IfcTank" ;
    rdfs:label "Tank"@en ;
    rdfs:comment "A vessel that stores a liquid or a gas."@en .

tec:FlowTreatmentDevice a owl:Class ;
    rdfs:subClassOf tec:DistributionElement ;
    tec:ifcClass "IfcFlowTreatmentDevice" ;
    rdfs:label "Flow treatment device"@en ;
    rdfs:comment "A filter, grease interceptor or silencer that treats a flow."@en .

tec:EnergyConversionDevice a owl:Class ;
    rdfs:subClassOf tec:DistributionElement ;
    tec:ifcClass "IfcEnergyConversionDevice" ;
    rdfs:label "Energy conversion device"@en ;
    rdfs:comment "A boiler, chiller, heat pump, transformer, generator or solar panel."@en .

tec:Boiler a owl:Class ;
    rdfs:subClassOf tec:EnergyConversionDevice ;
    tec:ifcClass "IfcBoiler" ;
    rdfs:label "Boiler"@en ;
    rdfs:comment "A boiler that heats water for heating or hot water."@en .

tec:SolarDevice a owl:Class ;
    rdfs:subClassOf tec:EnergyConversionDevice ;
    tec:ifcClass "IfcSolarDevice" ;
    rdfs:label "Solar device"@en ;
    rdfs:comment "A solar panel or collector."@en .

tec:Transformer a owl:Class ;
    rdfs:subClassOf tec:EnergyConversionDevice ;
    tec:ifcClass "IfcTransformer" ;
    rdfs:label "Transformer"@en ;
    rdfs:comment "An electrical transformer, from a substation to a doorbell."@en .

tec:DistributionChamber a owl:Class ;
    rdfs:subClassOf tec:DistributionElement ;
    tec:ifcClass "IfcDistributionChamberElement" ;
    rdfs:label "Distribution chamber"@en ;
    rdfs:comment "A manhole, inspection chamber, trench or duct bank that houses services and gives access to them."@en .

tec:ControlElement a owl:Class ;
    rdfs:subClassOf tec:DistributionElement ;
    tec:ifcClass "IfcDistributionControlElement" ;
    rdfs:label "Control element"@en ;
    rdfs:comment "A sensor, alarm, actuator or controller of services."@en .

tec:Sensor a owl:Class ;
    rdfs:subClassOf tec:ControlElement ;
    tec:ifcClass "IfcSensor" ;
    rdfs:label "Sensor"@en ;
    rdfs:comment "A device that measures something, such as temperature, smoke or movement."@en .

tec:Alarm a owl:Class ;
    rdfs:subClassOf tec:ControlElement ;
    tec:ifcClass "IfcAlarm" ;
    rdfs:label "Alarm"@en ;
    rdfs:comment "A bell, siren or light that warns people."@en .

tec:ElementAssembly a owl:Class ;
    rdfs:subClassOf tec:PhysicalElement ;
    tec:ifcClass "IfcElementAssembly" ;
    rdfs:label "Element assembly"@en ;
    rdfs:comment "A group of elements made or delivered as one unit, such as a truss, a prefabricated stair or a frame."@en .

tec:ConstructionPart a owl:Class ;
    rdfs:subClassOf tec:PhysicalElement ;
    tec:ifcClass "IfcElementComponent" ;
    rdfs:label "Construction part"@en ;
    rdfs:comment "A small physical part of a built element: a fastener, an accessory, reinforcement, a sign. Not to be confused with tec:Component, a human concept such as a lock, kept on the layer side."@en .

tec:ElementPart a owl:Class ;
    rdfs:subClassOf tec:ConstructionPart ;
    tec:ifcClass "IfcBuildingElementPart" ;
    rdfs:label "Element part"@en ;
    rdfs:comment "A piece of a built element modelled on its own, such as one layer of a wall."@en .

tec:Fastener a owl:Class ;
    rdfs:subClassOf tec:ConstructionPart ;
    tec:ifcClass "IfcFastener" ;
    rdfs:label "Fastener"@en ;
    rdfs:comment "A screw, bolt, nail, weld or glue joint that holds parts together."@en .

tec:MechanicalFastener a owl:Class ;
    rdfs:subClassOf tec:Fastener ;
    tec:ifcClass "IfcMechanicalFastener" ;
    rdfs:label "Mechanical fastener"@en ;
    rdfs:comment "A bolt, screw, nail or anchor."@en .

tec:Accessory a owl:Class ;
    rdfs:subClassOf tec:ConstructionPart ;
    tec:ifcClass "IfcDiscreteAccessory" ;
    rdfs:label "Accessory"@en ;
    rdfs:comment "A small fixed accessory, such as a bracket, a hanger or a shoe."@en .

tec:Reinforcement a owl:Class ;
    rdfs:subClassOf tec:ConstructionPart ;
    tec:ifcClass "IfcReinforcingElement" ;
    rdfs:label "Reinforcement"@en ;
    rdfs:comment "Steel bars, meshes or tendons inside concrete."@en .

tec:Sign a owl:Class ;
    rdfs:subClassOf tec:ConstructionPart ;
    tec:ifcClass "IfcSign" ;
    rdfs:label "Sign"@en ;
    rdfs:comment "A sign with text or symbols, such as a road sign or a room sign."@en .

tec:ImpactProtection a owl:Class ;
    rdfs:subClassOf tec:ConstructionPart ;
    tec:ifcClass "IfcImpactProtectionDevice" ;
    rdfs:label "Impact protection"@en ;
    rdfs:comment "A crash barrier, bumper or other device that absorbs impacts."@en .

tec:VibrationDamper a owl:Class ;
    rdfs:subClassOf tec:ConstructionPart ;
    tec:ifcClass "IfcVibrationDamper" ;
    rdfs:label "Vibration damper"@en ;
    rdfs:comment "A device that absorbs vibration in a structure."@en .

tec:VibrationIsolator a owl:Class ;
    rdfs:subClassOf tec:ConstructionPart ;
    tec:ifcClass "IfcVibrationIsolator" ;
    rdfs:label "Vibration isolator"@en ;
    rdfs:comment "A spring or pad that keeps vibration of a machine away from the structure."@en .

tec:UnclassifiedElement a owl:Class ;
    rdfs:subClassOf tec:BuiltElement ;
    tec:ifcClass "IfcBuildingElementProxy" ;
    rdfs:label "Unclassified element"@en ;
    rdfs:comment "A built element its authoring tool did not classify (an IFC proxy): anything from a chimney modelled as a plain box to a helper marker. It is matter unless its element role says otherwise."@en .

tec:SystemFurniture a owl:Class ;
    rdfs:subClassOf tec:Furnishing ;
    tec:ifcClass "IfcSystemFurnitureElement" ;
    rdfs:label "System furniture"@en ;
    rdfs:comment "A part of a modular furniture system, such as an office partition panel or a worktop."@en .

tec:VirtualElement a owl:Class ;
    rdfs:subClassOf bot:Element ;
    tec:ifcClass "IfcVirtualElement" ;
    rdfs:label "Virtual element"@en ;
    rdfs:comment "A boundary without matter, used to divide spaces where nothing physical does, such as a line across an open plan. Its element role is zone."@en .

tec:Feature a owl:Class ;
    rdfs:subClassOf bot:Element ;
    tec:ifcClass "IfcFeatureElement" ;
    rdfs:label "Feature"@en ;
    rdfs:comment "A change to another element's shape rather than an element of its own: an opening, a recess, a projection, a cut in the ground. It is not matter."@en .

tec:EarthworksCut a owl:Class ;
    rdfs:subClassOf tec:Feature ;
    tec:ifcClass "IfcEarthworksCut" ;
    rdfs:label "Earthworks cut"@en ;
    rdfs:comment "A volume of ground removed by excavation, such as a trench or a cutting. Like an opening, it is a void."@en .

tec:PortableObject a owl:Class ;
    rdfs:subClassOf tec:PhysicalObject ;
    rdfs:label "Portable object"@en ;
    rdfs:comment "A physical object that is carried rather than placed, with no own geometry at the current level of detail; stored on the layer side only."@en .

tec:Item a owl:Class ;
    rdfs:subClassOf tec:PortableObject ;
    rdfs:label "Item"@en ;
    rdfs:comment "A portable object that can be held in a container, for example clothing or a book."@en .

#################################################################
# Classes: information products (described, never matter)
#################################################################

tec:InformationProduct a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    rdfs:label "Information product"@en ;
    rdfs:comment "A product of an IFC model that describes or positions the built world rather than being part of it: annotations, grids and alignments, connection ports, structural analysis models. Every IFC product gets a layer entry, so these have classes too, but they are never matter."@en .

tec:UnclassifiedProduct a owl:Class ;
    rdfs:subClassOf owl:Thing ;
    tec:ifcClass "IfcProduct" ;
    rdfs:label "Unclassified product"@en ;
    rdfs:comment "A product whose kind IFC does not say, such as an IfcProxy in an IFC4 or IFC2X3 file (IFC 4.3 dropped IfcProxy). Kept so that every product has a layer entry; it is never matter."@en .

tec:Annotation a owl:Class ;
    rdfs:subClassOf tec:InformationProduct ;
    tec:ifcClass "IfcAnnotation" ;
    rdfs:label "Annotation"@en ;
    rdfs:comment "A drawing note, dimension, label or survey mark. Its element role is marker."@en .

tec:PositioningElement a owl:Class ;
    rdfs:subClassOf tec:InformationProduct ;
    tec:ifcClass "IfcPositioningElement" ;
    rdfs:label "Positioning element"@en ;
    rdfs:comment "Geometry used to place other things: a grid, an alignment, a reference point along a road."@en .

tec:Grid a owl:Class ;
    rdfs:subClassOf tec:PositioningElement ;
    tec:ifcClass "IfcGrid" ;
    rdfs:label "Grid"@en ;
    rdfs:comment "A set of grid lines that columns and walls are set out on."@en .

tec:Alignment a owl:Class ;
    rdfs:subClassOf tec:PositioningElement ;
    tec:ifcClass "IfcAlignment" ;
    rdfs:label "Alignment"@en ;
    rdfs:comment "The centre line of a road, railway or other linear facility, with its horizontal and vertical layout."@en .

tec:AlignmentLayout a owl:Class ;
    rdfs:subClassOf tec:InformationProduct ;
    tec:ifcClass "IfcLinearElement" ;
    rdfs:label "Alignment layout"@en ;
    rdfs:comment "A curve an alignment is made of: its horizontal, vertical or cant layout, or one of their segments."@en .

tec:Port a owl:Class ;
    rdfs:subClassOf tec:InformationProduct ;
    tec:ifcClass "IfcPort" ;
    rdfs:label "Port"@en ;
    rdfs:comment "A connection point of a services element, where a pipe, duct or cable attaches."@en .

tec:StructuralAnalysisItem a owl:Class ;
    rdfs:subClassOf tec:InformationProduct ;
    tec:ifcClass "IfcStructuralItem" ;
    rdfs:label "Structural analysis item"@en ;
    rdfs:comment "A member, surface or connection of a structural analysis model: an idealisation of physical elements as lines, surfaces and points, not an element itself."@en .

tec:StructuralLoad a owl:Class ;
    rdfs:subClassOf tec:InformationProduct ;
    tec:ifcClass "IfcStructuralActivity" ;
    rdfs:label "Structural load"@en ;
    rdfs:comment "A load or a reaction in a structural analysis model."@en .

#################################################################
# Classes: components (human concepts as parts)
#################################################################

tec:Component a owl:Class ;
    rdfs:subClassOf tec:PhysicalObject ;
    rdfs:label "Component"@en ;
    rdfs:comment "A module that realises a human concept (access control, operation, shading) as a part of a host element. Stored on the layer side and attached to the host by its GlobalId."@en .

tec:Lock a owl:Class ;
    rdfs:subClassOf tec:Component ;
    rdfs:label "Lock"@en ;
    rdfs:comment "A mechanism that keeps its host (usually a door) shut until operated with the key it requires."@en .

tec:Key a owl:Class ;
    rdfs:subClassOf tec:Component , tec:PortableObject ;
    rdfs:label "Key"@en ;
    rdfs:comment "A portable component that operates one or more locks."@en .

tec:Handle a owl:Class ;
    rdfs:subClassOf tec:Component ;
    rdfs:label "Handle"@en ;
    rdfs:comment "A grip used to operate a door, window or container."@en .

tec:Hinge a owl:Class ;
    rdfs:subClassOf tec:Component ;
    rdfs:label "Hinge"@en ;
    rdfs:comment "A pivot joint on which a door, window or lid turns."@en .

tec:Curtain a owl:Class ;
    rdfs:subClassOf tec:Component ;
    rdfs:label "Curtain"@en ;
    rdfs:comment "A textile screen attached to a window that can be opened or closed to control light and view."@en .

#################################################################
# Classes: containers
#################################################################

tec:Container a owl:Class ;
    rdfs:subClassOf tec:PhysicalObject ;
    rdfs:label "Container"@en ;
    rdfs:comment "An object that holds contents, related to them by tec:contains."@en .

tec:Wardrobe a owl:Class ;
    rdfs:subClassOf tec:Container , tec:Furnishing ;
    tec:ifcClass "IfcFurniture" ;
    tec:ifcPredefinedType "USERDEFINED" ;
    tec:ifcObjectType "WARDROBE" ;
    rdfs:label "Wardrobe"@en ;
    rdfs:comment "A tall cupboard for clothes."@en .

tec:Box a owl:Class ;
    rdfs:subClassOf tec:Container , tec:Furnishing ;
    tec:ifcClass "IfcFurniture" ;
    tec:ifcPredefinedType "USERDEFINED" ;
    tec:ifcObjectType "BOX" ;
    rdfs:label "Box"@en ;
    rdfs:comment "A rigid container with a lid or open top."@en .

#################################################################
# Classes: materials and states
#################################################################

tec:Material a owl:Class ;
    tec:ifcClass "IfcMaterial" ;
    rdfs:label "Material"@en ;
    rdfs:comment "A substance elements are made of, with base matter properties: stability, decay rate and resistance."@en .

tec:MaterialState a owl:Class ;
    rdfs:label "Material state"@en ;
    rdfs:comment "The current condition of the matter of one element: its material and present stability, decay and resistance."@en .

#################################################################
# Classes: human abstractions
#################################################################

tec:HumanAbstraction a owl:Class ;
    rdfs:label "Human abstraction"@en ;
    rdfs:comment "A human made definition laid over the physical base layer (rooms, dwellings, zoning). It refers to physical or spatial elements and never replaces them."@en .

tec:Room a owl:Class ;
    rdfs:subClassOf tec:HumanAbstraction ;
    rdfs:label "Room"@en ;
    rdfs:comment "A named place with a function, laid over a space."@en .

tec:OutdoorArea a owl:Class ;
    rdfs:subClassOf tec:HumanAbstraction ;
    rdfs:label "Outdoor area"@en ;
    rdfs:comment "A named outdoor place, such as a front yard, laid over an exterior space."@en .

tec:Dwelling a owl:Class ;
    rdfs:subClassOf tec:HumanAbstraction ;
    rdfs:label "Dwelling"@en ;
    rdfs:comment "A home: a group of rooms used by one household, laid over a building."@en .

tec:RoomFunction a owl:Class ;
    rdfs:label "Room function"@en ;
    rdfs:comment "What a room is used for. Instances are named individuals such as tec:Kitchen."@en .

tec:AssertedPassage a owl:Class ;
    rdfs:label "Asserted passage"@en ;
    rdfs:comment "A connection between spaces stated in the layer file, by a rule or a person, where the IFC file has no door, opening or stair that shows it: an open plan boundary, a missing wall, a ladder or a hole in a ruin. Kept apart from passages derived from IFC so the two can be compared. Not matter."@en .

tec:PassageKind a owl:Class ;
    rdfs:label "Passage kind"@en ;
    rdfs:comment "Why an asserted passage exists. Instances are tec:OpenBoundary and tec:DeclaredPassage."@en .

tec:ElementRole a owl:Class ;
    rdfs:label "Element role"@en ;
    rdfs:comment "What an element's geometry stands for: matter, a marker or a zone. Instances are tec:MatterRole, tec:MarkerRole and tec:ZoneRole. Only matter becomes voxels, separates spaces or gives quantities."@en .

tec:RelativePosition a owl:Class ;
    rdfs:label "Relative position"@en ;
    rdfs:comment "How an object sits relative to the thing it is placed in or on. Instances: tec:On, tec:Under, tec:Inside, tec:Beside."@en .

#################################################################
# Classes: layer file and provenance
#################################################################

tec:LayerFile a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Layer file"@en ;
    rdfs:comment "A JSON-LD document holding the non geometric layers of a model, linked to an IFC file by GlobalIds."@en .

tec:Rule a owl:Class ;
    rdfs:subClassOf prov:Plan ;
    rdfs:label "Rule"@en ;
    rdfs:comment "A named, versioned, deterministic piece of generator logic."@en .

tec:Generator a owl:Class ;
    rdfs:subClassOf prov:SoftwareAgent ;
    rdfs:label "Generator"@en ;
    rdfs:comment "The program, with its version, that applied rules to a brief."@en .

tec:ReferenceFrame a owl:Class ;
    rdfs:label "Reference frame"@en ;
    rdfs:comment "Layer L0: where a model's local coordinates (metres, Z up) sit in the world, as a coordinate reference system and a map conversion (origin, rotation, scale), the same parameters as IFC's IfcMapConversion. Stated in the layer file only when the IFC file has no georeference or a wrong one (ADR 0024)."@en .

tec:Migration a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Migration"@en ;
    rdfs:comment "One update of a layer file to an edited IFC file: which IFC file it moved from and to, and which elements were added, reclassified or dropped (ADR 0023)."@en .

tec:ProvenanceRecord a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Provenance record"@en ;
    rdfs:comment "The record of one generation step: which rule, with which inputs and which generator, produced an element or record."@en .

#################################################################
# Object properties
#################################################################

tec:contains a owl:ObjectProperty ;
    rdfs:domain tec:Container ;
    rdfs:range tec:PhysicalObject ;
    owl:inverseOf tec:containedIn ;
    rdfs:label "contains"@en ;
    rdfs:comment "A container holds an object as its content."@en .

tec:containedIn a owl:ObjectProperty ;
    rdfs:label "contained in"@en ;
    rdfs:comment "Inverse of tec:contains."@en .

tec:adjacentTo a owl:ObjectProperty , owl:SymmetricProperty ;
    rdfs:subPropertyOf bot:adjacentZone ;
    rdfs:domain tec:SpatialElement ;
    rdfs:range tec:SpatialElement ;
    rdfs:label "adjacent to"@en ;
    rdfs:comment "Two spaces share a boundary element (wall, slab). Derived from geometry."@en .

tec:hosts a owl:ObjectProperty ;
    rdfs:subPropertyOf bot:hostsElement ;
    rdfs:domain tec:PhysicalElement ;
    rdfs:range tec:Opening ;
    owl:inverseOf tec:hostedBy ;
    rdfs:label "hosts"@en ;
    rdfs:comment "A host element (such as a wall) carries an opening that voids it (IfcRelVoidsElement)."@en .

tec:hostedBy a owl:ObjectProperty ;
    rdfs:label "hosted by"@en ;
    rdfs:comment "Inverse of tec:hosts."@en .

tec:fills a owl:ObjectProperty ;
    rdfs:domain tec:BuiltElement ;
    rdfs:range tec:Opening ;
    owl:inverseOf tec:filledBy ;
    rdfs:label "fills"@en ;
    rdfs:comment "A door or window fills an opening (IfcRelFillsElement)."@en .

tec:filledBy a owl:ObjectProperty ;
    rdfs:label "filled by"@en ;
    rdfs:comment "Inverse of tec:fills."@en .

tec:connects a owl:ObjectProperty ;
    rdfs:range tec:SpatialElement ;
    rdfs:label "connects"@en ;
    rdfs:comment "A passage lets one move between the spaces it connects; an edge of the connectivity graph. Derived from IFC geometry for doors, unfilled openings and stairs; stated in the layer file for a tec:AssertedPassage."@en .

tec:passageKind a owl:ObjectProperty ;
    rdfs:domain tec:AssertedPassage ;
    rdfs:range tec:PassageKind ;
    rdfs:label "passage kind"@en ;
    rdfs:comment "Why an asserted passage exists: an open boundary found by a rule, or a passage declared by a person or a brief."@en .

tec:requiresKey a owl:ObjectProperty ;
    rdfs:domain tec:Lock ;
    rdfs:range tec:Key ;
    owl:inverseOf tec:fitsLock ;
    rdfs:label "requires key"@en ;
    rdfs:comment "A lock can only be operated with this key."@en .

tec:fitsLock a owl:ObjectProperty ;
    rdfs:label "fits lock"@en ;
    rdfs:comment "Inverse of tec:requiresKey."@en .

tec:placedIn a owl:ObjectProperty ;
    rdfs:domain tec:PhysicalObject ;
    rdfs:label "placed in"@en ;
    rdfs:comment "Where an object is: a space, or another object it is in, on or under (see tec:relativePosition)."@en .

tec:relativePosition a owl:ObjectProperty ;
    rdfs:range tec:RelativePosition ;
    rdfs:label "relative position"@en ;
    rdfs:comment "How an object sits relative to the target of tec:placedIn."@en .

tec:componentOf a owl:ObjectProperty ;
    rdfs:domain tec:Component ;
    rdfs:range tec:PhysicalElement ;
    owl:inverseOf tec:hasComponent ;
    rdfs:label "component of"@en ;
    rdfs:comment "The host element a component is attached to."@en .

tec:hasComponent a owl:ObjectProperty ;
    rdfs:label "has component"@en ;
    rdfs:comment "Inverse of tec:componentOf."@en .

tec:overlays a owl:ObjectProperty ;
    rdfs:domain tec:HumanAbstraction ;
    rdfs:label "overlays"@en ;
    rdfs:comment "The physical or spatial element a human abstraction is laid over."@en .

tec:includes a owl:ObjectProperty ;
    rdfs:domain tec:HumanAbstraction ;
    rdfs:range tec:HumanAbstraction ;
    rdfs:label "includes"@en ;
    rdfs:comment "A human abstraction groups others, for example a dwelling includes rooms."@en .

tec:function a owl:ObjectProperty ;
    rdfs:domain tec:HumanAbstraction ;
    rdfs:range tec:RoomFunction ;
    rdfs:label "function"@en ;
    rdfs:comment "What a room or area is used for."@en .

tec:elementRole a owl:ObjectProperty ;
    rdfs:domain tec:PhysicalElement ;
    rdfs:range tec:ElementRole ;
    rdfs:label "element role"@en ;
    rdfs:comment "Role of an element, stated in the layer file so that the IFC file is never edited. When absent the role follows the IFC class: IfcVirtualElement is a zone, IfcAnnotation a marker, every other element matter."@en .

tec:material a owl:ObjectProperty ;
    rdfs:range tec:Material ;
    rdfs:label "material"@en ;
    rdfs:comment "The material an element or material state refers to."@en .

tec:stateOf a owl:ObjectProperty ;
    rdfs:domain tec:MaterialState ;
    rdfs:range tec:PhysicalElement ;
    rdfs:label "state of"@en ;
    rdfs:comment "The element whose matter the state describes."@en .

tec:about a owl:ObjectProperty ;
    rdfs:domain tec:ProvenanceRecord ;
    rdfs:label "about"@en ;
    rdfs:comment "The element or record a provenance record describes."@en .

tec:rule a owl:ObjectProperty ;
    rdfs:domain tec:ProvenanceRecord ;
    rdfs:range tec:Rule ;
    rdfs:label "rule"@en ;
    rdfs:comment "The rule applied in a generation step."@en .

tec:generatedBy a owl:ObjectProperty ;
    rdfs:range tec:Generator ;
    rdfs:label "generated by"@en ;
    rdfs:comment "The generator that performed a generation step, a migration, or produced a layer file."@en .

tec:ifcProject a owl:ObjectProperty ;
    rdfs:domain tec:LayerFile ;
    rdfs:label "IFC project"@en ;
    rdfs:comment "The IfcProject (by GlobalId) of the IFC file this layer file belongs to."@en .

tec:layerElements a owl:ObjectProperty ;
    rdfs:domain tec:LayerFile ;
    rdfs:label "layer elements"@en ;
    rdfs:comment "Section of a layer file: the index of IFC elements with their ontology class and semantic path."@en .

tec:layerMaterials a owl:ObjectProperty ;
    rdfs:domain tec:LayerFile ;
    rdfs:range tec:Material ;
    rdfs:label "layer materials"@en ;
    rdfs:comment "Section of a layer file: materials and their base matter properties."@en .

tec:layerComponents a owl:ObjectProperty ;
    rdfs:domain tec:LayerFile ;
    rdfs:range tec:Component ;
    rdfs:label "layer components"@en ;
    rdfs:comment "Section of a layer file: components attached to elements."@en .

tec:layerContainers a owl:ObjectProperty ;
    rdfs:domain tec:LayerFile ;
    rdfs:range tec:Container ;
    rdfs:label "layer containers"@en ;
    rdfs:comment "Section of a layer file: containers and their contents."@en .

tec:layerMaterialStates a owl:ObjectProperty ;
    rdfs:domain tec:LayerFile ;
    rdfs:range tec:MaterialState ;
    rdfs:label "layer material states"@en ;
    rdfs:comment "Section of a layer file: the material state of each element."@en .

tec:layerHumanAbstractions a owl:ObjectProperty ;
    rdfs:domain tec:LayerFile ;
    rdfs:range tec:HumanAbstraction ;
    rdfs:label "layer human abstractions"@en ;
    rdfs:comment "Section of a layer file: rooms, areas and dwellings."@en .

tec:layerPassages a owl:ObjectProperty ;
    rdfs:domain tec:LayerFile ;
    rdfs:range tec:AssertedPassage ;
    rdfs:label "layer passages"@en ;
    rdfs:comment "Section of a layer file: passages asserted by rules or people, kept apart from the passages derived from IFC."@en .

tec:layerRules a owl:ObjectProperty ;
    rdfs:domain tec:LayerFile ;
    rdfs:range tec:Rule ;
    rdfs:label "layer rules"@en ;
    rdfs:comment "Section of a layer file: the rules used by the generator."@en .

tec:referenceFrame a owl:ObjectProperty ;
    rdfs:domain tec:LayerFile ;
    rdfs:range tec:ReferenceFrame ;
    rdfs:label "reference frame"@en ;
    rdfs:comment "The reference frame a layer file states for its model; it takes precedence over the IFC file's georeference."@en .

tec:layerMigrations a owl:ObjectProperty ;
    rdfs:domain tec:LayerFile ;
    rdfs:range tec:Migration ;
    rdfs:label "layer migrations"@en ;
    rdfs:comment "The migrations a layer file went through, oldest first."@en .

tec:layerProvenance a owl:ObjectProperty ;
    rdfs:domain tec:LayerFile ;
    rdfs:range tec:ProvenanceRecord ;
    rdfs:label "layer provenance"@en ;
    rdfs:comment "Section of a layer file: one provenance record per generated element or record."@en .

#################################################################
# Datatype properties
#################################################################

tec:opensToOutside a owl:DatatypeProperty ;
    rdfs:domain tec:AssertedPassage ;
    rdfs:range xsd:boolean ;
    rdfs:label "opens to outside"@en ;
    rdfs:comment "True when an asserted passage connects its one space with the outside of the building."@en .

tec:stability a owl:DatatypeProperty ;
    rdfs:range xsd:double ;
    rdfs:label "stability"@en ;
    rdfs:comment "Structural stability in [0, 1]; 1 is fully stable. Base value on a material, current value on a material state."@en .

tec:decay a owl:DatatypeProperty ;
    rdfs:domain tec:MaterialState ;
    rdfs:range xsd:double ;
    rdfs:label "decay"@en ;
    rdfs:comment "Current decay level in [0, 1]; 0 is pristine, 1 is fully decayed."@en .

tec:decayRate a owl:DatatypeProperty ;
    rdfs:domain tec:Material ;
    rdfs:range xsd:double ;
    rdfs:label "decay rate"@en ;
    rdfs:comment "Decay gained per year of full exposure, as a fraction."@en .

tec:resistance a owl:DatatypeProperty ;
    rdfs:range xsd:double ;
    rdfs:label "resistance"@en ;
    rdfs:comment "Resistance to damage (impact, fire, moisture combined) in [0, 1]; 1 is most resistant."@en .

tec:density a owl:DatatypeProperty ;
    rdfs:domain tec:Material ;
    rdfs:range xsd:double ;
    rdfs:label "density"@en ;
    rdfs:comment "Mass density in kilograms per cubic metre."@en .

tec:category a owl:DatatypeProperty ;
    rdfs:domain tec:Material ;
    rdfs:range xsd:string ;
    rdfs:label "category"@en ;
    rdfs:comment "Material family, for example masonry, concrete, timber, glass."@en .

tec:ifcMaterialName a owl:DatatypeProperty ;
    rdfs:domain tec:Material ;
    rdfs:range xsd:string ;
    rdfs:label "IFC material name"@en ;
    rdfs:comment "Name of the IfcMaterial this material corresponds to. IfcMaterial has no GlobalId, so the link is by name within one IFC file."@en .

tec:locked a owl:DatatypeProperty ;
    rdfs:domain tec:Lock ;
    rdfs:range xsd:boolean ;
    rdfs:label "locked"@en ;
    rdfs:comment "True if the lock is currently engaged."@en .

tec:isOpen a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "is open"@en ;
    rdfs:comment "True if a curtain, door or lid is currently open."@en .

tec:mountingHeight a owl:DatatypeProperty ;
    rdfs:domain tec:Component ;
    rdfs:range xsd:double ;
    rdfs:label "mounting height"@en ;
    rdfs:comment "Height of a component above the bottom of its host, in metres."@en .

tec:capacity a owl:DatatypeProperty ;
    rdfs:domain tec:Container ;
    rdfs:range xsd:double ;
    rdfs:label "capacity"@en ;
    rdfs:comment "Usable inner volume of a container in cubic metres."@en .

tec:globalId a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "GlobalId"@en ;
    rdfs:comment "The IFC GlobalId (22 characters) of a node. Also the last segment of its IRI."@en .

tec:path a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "semantic path"@en ;
    rdfs:comment "The semantic path the GlobalId was derived from, for example poc_house/building/storey-0/wall-south."@en .

tec:ifcEntity a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "IFC entity"@en ;
    rdfs:comment "The IFC entity name of an element instance as written in the IFC file."@en .

tec:formatVersion a owl:DatatypeProperty ;
    rdfs:domain tec:LayerFile ;
    rdfs:range xsd:string ;
    rdfs:label "format version"@en ;
    rdfs:comment "Version of the layer file format."@en .

tec:ifcFile a owl:DatatypeProperty ;
    rdfs:domain tec:LayerFile ;
    rdfs:range xsd:string ;
    rdfs:label "IFC file"@en ;
    rdfs:comment "Relative path of the IFC file of the canonical pair."@en .

tec:ifcSchema a owl:DatatypeProperty ;
    rdfs:domain tec:LayerFile ;
    rdfs:range xsd:string ;
    rdfs:label "IFC schema"@en ;
    rdfs:comment "Schema identifier of the IFC file, for example IFC4X3_ADD2."@en .

tec:ifcSha256 a owl:DatatypeProperty ;
    rdfs:domain tec:LayerFile ;
    rdfs:range xsd:string ;
    rdfs:label "IFC SHA-256"@en ;
    rdfs:comment "SHA-256 of the IFC file bytes the layer file was written or last migrated for. A matching file is an exact binding; a different file whose GlobalIds still match is a compatible one (ADR 0023)."@en .

tec:crs a owl:DatatypeProperty ;
    rdfs:domain tec:ReferenceFrame ;
    rdfs:range xsd:string ;
    rdfs:label "coordinate reference system"@en ;
    rdfs:comment "Identifier of the map's coordinate reference system, usually an EPSG code such as EPSG:32760."@en .

tec:crsDescription a owl:DatatypeProperty ;
    rdfs:domain tec:ReferenceFrame ;
    rdfs:range xsd:string ;
    rdfs:label "CRS description"@en ;
    rdfs:comment "Human readable name of the coordinate reference system, such as WGS 84 / UTM zone 60S."@en .

tec:eastings a owl:DatatypeProperty ;
    rdfs:domain tec:ReferenceFrame ;
    rdfs:range xsd:double ;
    rdfs:label "eastings"@en ;
    rdfs:comment "Map easting of the model's local origin, in map units."@en .

tec:northings a owl:DatatypeProperty ;
    rdfs:domain tec:ReferenceFrame ;
    rdfs:range xsd:double ;
    rdfs:label "northings"@en ;
    rdfs:comment "Map northing of the model's local origin, in map units."@en .

tec:orthogonalHeight a owl:DatatypeProperty ;
    rdfs:domain tec:ReferenceFrame ;
    rdfs:range xsd:double ;
    rdfs:label "orthogonal height"@en ;
    rdfs:comment "Height of the model's local origin above the map's vertical datum, in map units."@en .

tec:xAxisAbscissa a owl:DatatypeProperty ;
    rdfs:domain tec:ReferenceFrame ;
    rdfs:range xsd:double ;
    rdfs:label "x axis abscissa"@en ;
    rdfs:comment "Easting component of the direction of the model's local x axis on the map (with tec:xAxisOrdinate it gives the rotation)."@en .

tec:xAxisOrdinate a owl:DatatypeProperty ;
    rdfs:domain tec:ReferenceFrame ;
    rdfs:range xsd:double ;
    rdfs:label "x axis ordinate"@en ;
    rdfs:comment "Northing component of the direction of the model's local x axis on the map."@en .

tec:mapScale a owl:DatatypeProperty ;
    rdfs:domain tec:ReferenceFrame ;
    rdfs:range xsd:double ;
    rdfs:label "map scale"@en ;
    rdfs:comment "Map units per metre of local coordinates; 1 for a metric map without a projection scale factor."@en .

tec:mapUnitScale a owl:DatatypeProperty ;
    rdfs:domain tec:ReferenceFrame ;
    rdfs:range xsd:double ;
    rdfs:label "map unit scale"@en ;
    rdfs:comment "Metres per map unit; 1 for maps in metres, 0.3048 for maps in feet."@en .

tec:latitude a owl:DatatypeProperty ;
    rdfs:domain tec:ReferenceFrame ;
    rdfs:range xsd:double ;
    rdfs:label "latitude"@en ;
    rdfs:comment "Approximate latitude of the model in decimal degrees (WGS 84), for display and search only."@en .

tec:longitude a owl:DatatypeProperty ;
    rdfs:domain tec:ReferenceFrame ;
    rdfs:range xsd:double ;
    rdfs:label "longitude"@en ;
    rdfs:comment "Approximate longitude of the model in decimal degrees (WGS 84), for display and search only."@en .

tec:fromIfcSha256 a owl:DatatypeProperty ;
    rdfs:domain tec:Migration ;
    rdfs:range xsd:string ;
    rdfs:label "from IFC SHA-256"@en ;
    rdfs:comment "SHA-256 of the IFC file a migration started from."@en .

tec:toIfcSha256 a owl:DatatypeProperty ;
    rdfs:domain tec:Migration ;
    rdfs:range xsd:string ;
    rdfs:label "to IFC SHA-256"@en ;
    rdfs:comment "SHA-256 of the IFC file a migration moved the layer file to."@en .

tec:changes a owl:DatatypeProperty ;
    rdfs:domain tec:Migration ;
    rdfs:range rdf:JSON ;
    rdfs:label "changes"@en ;
    rdfs:comment "What a migration changed (elements added, reclassified, dropped; records dropped or updated), as a JSON literal."@en .

tec:briefSha256 a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "brief SHA-256"@en ;
    rdfs:comment "SHA-256 of the brief file the model was generated from."@en .

tec:ruleId a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "rule id"@en ;
    rdfs:comment "Human readable identifier of a rule, for example poc_house.wall.exterior."@en .

tec:version a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "version"@en ;
    rdfs:comment "Version of a rule or generator."@en .

tec:tectonicaVersion a owl:DatatypeProperty ;
    rdfs:domain tec:Generator ;
    rdfs:range xsd:string ;
    rdfs:label "Tectonica version"@en ;
    rdfs:comment "Version of the Tectonica core library used by a generator."@en .

tec:inputs a owl:DatatypeProperty ;
    rdfs:domain tec:ProvenanceRecord ;
    rdfs:range rdf:JSON ;
    rdfs:label "inputs"@en ;
    rdfs:comment "The inputs given to the rule, as a JSON literal."@en .

tec:timestamp a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "timestamp"@en ;
    rdfs:comment "Timestamp taken from the brief (an input), never from the clock."@en .

#################################################################
# Derived quantities (computed from geometry, never authoritative)
#################################################################

tec:floorArea a owl:DatatypeProperty ;
    rdfs:domain tec:Space ;
    rdfs:range xsd:double ;
    rdfs:label "floor area"@en ;
    rdfs:comment "Area of the floor of a space in square metres, derived from its geometry."@en .

tec:clearHeight a owl:DatatypeProperty ;
    rdfs:domain tec:Space ;
    rdfs:range xsd:double ;
    rdfs:label "clear height"@en ;
    rdfs:comment "Height from the floor to the ceiling of a space in metres, derived from its geometry."@en .

tec:glazedArea a owl:DatatypeProperty ;
    rdfs:domain tec:Space ;
    rdfs:range xsd:double ;
    rdfs:label "glazed area"@en ;
    rdfs:comment "Total area of the windows that open onto a space, in square metres."@en .

tec:riserHeight a owl:DatatypeProperty ;
    rdfs:range xsd:double ;
    rdfs:label "riser height"@en ;
    rdfs:comment "Height of one step of a stair flight in metres (the rise)."@en .

tec:going a owl:DatatypeProperty ;
    rdfs:range xsd:double ;
    rdfs:label "going"@en ;
    rdfs:comment "Horizontal depth of one step of a stair flight in metres (the going or tread depth)."@en .

tec:guardHeight a owl:DatatypeProperty ;
    rdfs:range xsd:double ;
    rdfs:label "guard height"@en ;
    rdfs:comment "Height of a railing or guard in metres, derived from its geometry."@en .

#################################################################
# Norms (see ontology/tectonica-norms.ttl)
#################################################################

tec:NormKind a owl:Class ;
    rdfs:label "Norm kind"@en ;
    rdfs:comment "Where a norm comes from: a design convention, a building code, a technical standard or an accessibility standard."@en .

tec:normId a owl:AnnotationProperty ;
    rdfs:label "norm id"@en ;
    rdfs:comment "Stable identifier of a norm, for example CONV-BATH-DOOR. Briefs use it to accept a deviation."@en .

tec:normProfile a owl:AnnotationProperty ;
    rdfs:label "norm profile"@en ;
    rdfs:comment "The profile a norm belongs to: convention, or a country code such as us, br or gb-eng. Briefs choose which profiles apply."@en .

tec:normKind a owl:AnnotationProperty ;
    rdfs:label "norm kind"@en ;
    rdfs:comment "The tec:NormKind of a norm."@en .

tec:normSource a owl:AnnotationProperty ;
    rdfs:label "norm source"@en ;
    rdfs:comment "Citation of the document a norm comes from. Requirements are paraphrased, not quoted."@en .

#################################################################
# Named individuals
#################################################################

tec:DesignConvention a owl:NamedIndividual , tec:NormKind ;
    rdfs:label "design convention"@en ;
    rdfs:comment "Common practice in residential design that no law requires, such as a door on a bathroom."@en .

tec:BuildingCode a owl:NamedIndividual , tec:NormKind ;
    rdfs:label "building code"@en ;
    rdfs:comment "A requirement of a building code or regulation of a named jurisdiction."@en .

tec:TechnicalStandard a owl:NamedIndividual , tec:NormKind ;
    rdfs:label "technical standard"@en ;
    rdfs:comment "A requirement of a national technical standard that is not itself a building code, such as an ABNT NBR standard in Brazil."@en .

tec:AccessibilityStandard a owl:NamedIndividual , tec:NormKind ;
    rdfs:label "accessibility standard"@en ;
    rdfs:comment "A requirement of an accessibility standard."@en .

tec:OpenBoundary a owl:NamedIndividual , tec:PassageKind ;
    rdfs:label "open boundary"@en ;
    rdfs:comment "Found by a rule: two spaces, or a space and the outside, meet along a stretch with no wall or other separating element, wide and high enough to walk through."@en .

tec:DeclaredPassage a owl:NamedIndividual , tec:PassageKind ;
    rdfs:label "declared passage"@en ;
    rdfs:comment "Stated by a person or a brief, for example a ladder, a hatch or a climbable gap that the IFC file does not model as a passage."@en .

tec:MatterRole a owl:NamedIndividual , tec:ElementRole ;
    rdfs:label "matter"@en ;
    rdfs:comment "The element is physical matter: it becomes voxels, separates spaces and gives quantities. The default role."@en .

tec:MarkerRole a owl:NamedIndividual , tec:ElementRole ;
    rdfs:label "marker"@en ;
    rdfs:comment "Helper geometry that marks a point or reference, such as a project origin or a geo-reference point. Not matter; hidden in previews."@en .

tec:ZoneRole a owl:NamedIndividual , tec:ElementRole ;
    rdfs:label "zone"@en ;
    rdfs:comment "Invisible geometry that defines a zone or a volume, such as a no-build area or a gameplay trigger. Not matter; hidden in previews."@en .

tec:EntranceHall a owl:NamedIndividual , tec:RoomFunction ;
    rdfs:label "Entrance hall"@en ;
    rdfs:comment "Arrival and circulation space behind the main entrance."@en .

tec:LivingRoom a owl:NamedIndividual , tec:RoomFunction ;
    rdfs:label "Living room"@en ;
    rdfs:comment "Main day room of a dwelling."@en .

tec:Kitchen a owl:NamedIndividual , tec:RoomFunction ;
    rdfs:label "Kitchen"@en ;
    rdfs:comment "Room for preparing food."@en .

tec:Bedroom a owl:NamedIndividual , tec:RoomFunction ;
    rdfs:label "Bedroom"@en ;
    rdfs:comment "Room for sleeping."@en .

tec:Bathroom a owl:NamedIndividual , tec:RoomFunction ;
    rdfs:label "Bathroom"@en ;
    rdfs:comment "Room for washing."@en .

tec:Circulation a owl:NamedIndividual , tec:RoomFunction ;
    rdfs:label "Circulation"@en ;
    rdfs:comment "Space for moving between rooms: corridors, landings."@en .

tec:FrontYard a owl:NamedIndividual , tec:RoomFunction ;
    rdfs:label "Front yard"@en ;
    rdfs:comment "Outdoor area between a building and the street."@en .

tec:On a owl:NamedIndividual , tec:RelativePosition ;
    rdfs:label "on"@en ;
    rdfs:comment "Resting on top of the target."@en .

tec:Under a owl:NamedIndividual , tec:RelativePosition ;
    rdfs:label "under"@en ;
    rdfs:comment "Below the target, hidden by it."@en .

tec:Inside a owl:NamedIndividual , tec:RelativePosition ;
    rdfs:label "inside"@en ;
    rdfs:comment "Within the target."@en .

tec:Beside a owl:NamedIndividual , tec:RelativePosition ;
    rdfs:label "beside"@en ;
    rdfs:comment "Next to the target."@en .
