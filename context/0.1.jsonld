    "humanAbstractions": {"@id": "tec:layerHumanAbstractions", "@container": "@id"},
    "rules": {"@id": "tec:layerRules", "@container": "@id"},
    "provenance": {"@id": "tec:layerProvenance", "@container": "@id"},
    "generator": {"@id": "tec:generatedBy", "@type": "@id"},
    "generatedBy": {"@id": "tec:generatedBy", "@type": "@id"},
    "ifcProject": {"@id": "tec:ifcProject", "@type": "@id"},
    "contains": {"@id": "tec:contains", "@type": "@id"},
    "containedIn": {"@id": "tec:containedIn", "@type": "@id"},
    "componentOf": {"@id": "tec:componentOf", "@type": "@id"},
    "hasComponent": {"@id": "tec:hasComponent", "@type": "@id"},
    "requiresKey": {"@id": "tec:requiresKey", "@type": "@id"},
    "fitsLock": {"@id": "tec:fitsLock", "@type": "@id"},
    "placedIn": {"@id": "tec:placedIn", "@type": "@id"},
    "overlays": {"@id": "tec:overlays", "@type": "@id"},
    "includes": {"@id": "tec:includes", "@type": "@id"},
    "material": {"@id": "tec:material", "@type": "@id"},
    "stateOf": {"@id": "tec:stateOf", "@type": "@id"},
    "about": {"@id": "tec:about", "@type": "@id"},
    "rule": {"@id": "tec:rule", "@type": "@id"},
    "hosts": {"@id": "tec:hosts", "@type": "@id"},
    "hostedBy": {"@id": "tec:hostedBy", "@type": "@id"},
    "fills": {"@id": "tec:fills", "@type": "@id"},
    "filledBy": {"@id": "tec:filledBy", "@type": "@id"},
    "connects": {"@id": "tec:connects", "@type": "@id"},
    "adjacentTo": {"@id": "tec:adjacentTo", "@type": "@id"},
    "function": {"@id": "tec:function", "@type": "@vocab"},
